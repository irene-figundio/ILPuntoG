@using System.Text.Json
@using Models
@{
    ViewData["Title"] = "Dashboard";
    var stats = (JsonElement)ViewBag.Stats;
    var kanbanTasks = (List<TodoTask>)ViewBag.KanbanTasks;
    var branchesSummary = ViewBag.BranchesSummary as List<dynamic>;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Bentornato, @(User.Identity?.Name ?? "Utente")!</h2>
            <p class="text-muted">Ecco cosa sta succedendo nel portale oggi.</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">Task Totali</h6>
                            <h2 class="mb-0 fw-bold">@stats.GetProperty("totalTasks").GetInt32()</h2>
                        </div>
                        <i class="fas fa-tasks fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">Completati</h6>
                            <h2 class="mb-0 fw-bold">@stats.GetProperty("completedTasks").GetInt32()</h2>
                        </div>
                        <i class="fas fa-check-double fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">In Corso</h6>
                            <h2 class="mb-0 fw-bold">@stats.GetProperty("inProgressTasks").GetInt32()</h2>
                        </div>
                        <i class="fas fa-spinner fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1">Prossimi Appt.</h6>
                            <h2 class="mb-0 fw-bold">@stats.GetProperty("upcomingAppointments").GetInt32()</h2>
                        </div>
                        <i class="fas fa-calendar-alt fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (User.IsInRole(Roles.SuperAdmin) && branchesSummary != null)
    {
        <h4 class="mb-4 fw-bold"><i class="fas fa-building me-2 text-secondary"></i>Panoramica Sedi (SuperAdmin)</h4>
        <div class="row mb-5">
            @foreach (var branch in branchesSummary)
            {
                var b = (JsonElement)branch;
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm border-top border-4 border-primary h-100">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@b.GetProperty("name").GetString()</h5>
                            <hr>
                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="fas fa-users-cog me-2 text-muted"></i>Clienti:</span>
                                <span class="badge bg-light text-dark">@b.GetProperty("clientCount").GetInt32()</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="fas fa-folder-open me-2 text-muted"></i>Progetti:</span>
                                <span class="badge bg-light text-dark">@b.GetProperty("projectCount").GetInt32()</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span><i class="fas fa-clipboard-list me-2 text-muted"></i>Task Attivi:</span>
                                <span class="badge bg-light text-dark">@b.GetProperty("taskCount").GetInt32()</span>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted d-block mb-1">Team:</small>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var member in b.GetProperty("team").EnumerateArray())
                                    {
                                        <span class="badge rounded-pill bg-info text-dark" style="font-size: 0.75rem;">@member.GetString()</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Kanban Board -->
    <h4 class="mb-4 fw-bold"><i class="fas fa-columns me-2 text-secondary"></i>Il Tuo Kanban</h4>
    <div class="row kanban-board g-3">
        <!-- Pending -->
        <div class="col-md-4">
            <div class="kanban-column p-3 rounded bg-light border shadow-sm">
                <h6 class="text-uppercase fw-bold mb-3 border-bottom pb-2 border-secondary border-2"><i class="fas fa-pause-circle me-2 text-secondary"></i>Da Fare</h6>
                <div class="kanban-items" id="pending-tasks">
                    @foreach (var t in kanbanTasks.Where(x => x.Status == TodoStatus.Pending))
                    {
                        <partial name="_KanbanCard" model="t" />
                    }
                </div>
            </div>
        </div>
        <!-- In Progress -->
        <div class="col-md-4">
            <div class="kanban-column p-3 rounded bg-light border shadow-sm border-warning">
                <h6 class="text-uppercase fw-bold mb-3 border-bottom pb-2 border-warning border-2"><i class="fas fa-play-circle me-2 text-warning"></i>In Corso</h6>
                <div class="kanban-items" id="inprogress-tasks">
                    @foreach (var t in kanbanTasks.Where(x => x.Status == TodoStatus.InProgress))
                    {
                        <partial name="_KanbanCard" model="t" />
                    }
                </div>
            </div>
        </div>
        <!-- Completed -->
        <div class="col-md-4">
            <div class="kanban-column p-3 rounded bg-light border shadow-sm border-success">
                <h6 class="text-uppercase fw-bold mb-3 border-bottom pb-2 border-success border-2"><i class="fas fa-check-circle me-2 text-success"></i>Completato</h6>
                <div class="kanban-items" id="completed-tasks">
                    @foreach (var t in kanbanTasks.Where(x => x.Status == TodoStatus.Completed))
                    {
                        <partial name="_KanbanCard" model="t" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .kanban-column {
        min-height: 500px;
    }
    .kanban-card {
        cursor: pointer;
        transition: transform 0.1s ease;
    }
    .kanban-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1) !important;
    }
    .bg-info-light {
        background-color: rgba(0, 123, 255, 0.1) !important;
        border: 2px dashed #007bff !important;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const columns = ['pending-tasks', 'inprogress-tasks', 'completed-tasks'];
            const statusMap = {
                'pending-tasks': 0,    // Pending
                'inprogress-tasks': 1, // InProgress
                'completed-tasks': 2   // Completed
            };

            columns.forEach(id => {
                const el = document.getElementById(id);
                Sortable.create(el, {
                    group: 'kanban',
                    animation: 150,
                    ghostClass: 'bg-info-light',
                    onStart: function() { window.isDragging = true; },
                    onEnd: function (evt) {
                        setTimeout(() => { window.isDragging = false; }, 100);
                        const taskId = evt.item.getAttribute('data-task-id');
                        const newStatus = statusMap[evt.to.id];

                        if (taskId && newStatus !== undefined) {
                            updateTaskStatus(taskId, newStatus);
                        }
                    }
                });
            });

            function updateTaskStatus(taskId, status) {
                const data = new URLSearchParams();
                data.append('type', 'task');
                data.append('dbId', taskId);
                data.append('newDate', new Date().toISOString());
                data.append('status', status);

                fetch('/Calendar/UpdateEvent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: data
                }).then(response => {
                    if (!response.ok) {
                        alert('Errore durante l\'aggiornamento dello stato');
                        location.reload();
                    }
                });
            }
        });
    </script>
}
