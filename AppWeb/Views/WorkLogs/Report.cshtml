@using System.Text.Json
@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Report Mensile Presenze";
    int month = ViewBag.Month;
    int year = ViewBag.Year;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-chart-pie text-primary me-2"></i>Report Presenze: @month/@year</h2>

        <form method="get" class="d-flex gap-2">
            <select name="month" class="form-select" style="width: auto;">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(i == month ? "selected" : null)">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i)</option>
                }
            </select>
            <input type="number" name="year" class="form-control" style="width: 100px;" value="@year" />
            <button type="submit" class="btn btn-outline-primary">Filtra</button>
        </form>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Collaboratore</th>
                            <th class="text-center">Ore Lavoro</th>
                            <th class="text-center">Ferie (h)</th>
                            <th class="text-center">Permessi (h)</th>
                            <th class="text-center">Malattia (h)</th>
                            <th class="text-center">Giorni Tot.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var element = (JsonElement)item;
                            <tr>
                                <td class="fw-bold">@(element.TryGetProperty("userName", out var name) ? name.GetString() : "N/D")</td>
                                <td class="text-center">@element.GetProperty("totalHours").GetDouble()</td>
                                <td class="text-center text-warning">@element.GetProperty("ferie").GetDouble()</td>
                                <td class="text-center text-info">@element.GetProperty("permessi").GetDouble()</td>
                                <td class="text-center text-danger">@element.GetProperty("malattia").GetDouble()</td>
                                <td class="text-center fw-bold">@element.GetProperty("totalDays").GetInt32()</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Nessun dato trovato per il periodo selezionato.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
