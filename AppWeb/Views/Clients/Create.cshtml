@model Models.Client
@{
    ViewData["Title"] = "Nuovo Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0"><i class="fas fa-user-plus me-2"></i>Nuovo Cliente</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Nome / Ragione Sociale</label>
                            <input asp-for="Name" class="form-control" placeholder="Esempio: Mario Rossi S.r.l." required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="email@esempio.com" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Telefono</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+39 ..." />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success flex-grow-1 py-2 fw-bold">SALVA CLIENTE</button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2 fw-bold">ANNULLA</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
