@model IEnumerable<Models.Client>
@{
    ViewData["Title"] = "Gestione Clienti";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users me-2"></i>Gestione Clienti</h2>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm"><i class="fas fa-plus me-1"></i> Nuovo Cliente</a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold">@item.Name</h5>
                    <p class="card-text text-muted mb-1"><i class="fas fa-envelope me-2"></i>@item.Email</p>
                    <p class="card-text text-muted"><i class="fas fa-phone me-2"></i>@item.PhoneNumber</p>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-4">Nessun cliente censito.</div>
}
