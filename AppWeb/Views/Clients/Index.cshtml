@model IEnumerable<Models.Client>
@{
    ViewData["Title"] = "Gestione Clienti";
}

<div class="p-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-black tracking-tight mb-1">Gestione Clienti</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Anagrafica clienti e contatti associati.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="location.href='/Clients/Create'" class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-lg text-sm font-bold shadow-md hover:bg-primary/90 transition-all">
                <span class="material-symbols-outlined text-lg">add_circle</span> Nuovo Cliente
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        @foreach (var item in Model)
        {
            <div class="bg-white dark:bg-[#1a202c] p-6 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-md transition-all group">
                <div class="flex justify-between items-start mb-4">
                    <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <button class="text-gray-300 hover:text-primary transition-colors">
                        <span class="material-symbols-outlined">more_horiz</span>
                    </button>
                </div>
                <h3 class="text-lg font-bold mb-2 group-hover:text-primary transition-colors">@item.Name</h3>
                <div class="space-y-2 mt-4 pt-4 border-t border-gray-50 dark:border-gray-800">
                    <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-lg">mail</span>
                        <span class="truncate">@item.Email</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-lg">phone</span>
                        <span>@item.PhoneNumber</span>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="mt-12 text-center py-12 bg-white dark:bg-[#1a202c] rounded-2xl border-2 border-dashed border-gray-200 dark:border-gray-800">
            <span class="material-symbols-outlined text-4xl text-gray-300 mb-2">person_off</span>
            <p class="text-gray-500">Nessun cliente censito.</p>
        </div>
    }
</div>
