@model Models.TodoTask

<div class="card mb-3 shadow-sm border-0 kanban-card border-start border-4 @(Model.Priority?.Level >= 4 ? "border-danger" : (Model.Priority?.Level == 3 ? "border-warning" : "border-info"))"
     data-task-id="@Model.Id"
     onclick="if(!window.isDragging) location.href='@Url.Action("Edit", "TodoTasks", new { id = Model.Id })'">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title fw-bold mb-0">@Model.Title</h6>
            <span class="badge bg-light text-dark small border">@Model.TaskType?.Name</span>
        </div>
        <p class="card-text small text-muted text-truncate">@Model.Description</p>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-@(Model.Deadline < DateTime.Now ? "danger" : "muted") fw-bold">
                <i class="fas fa-calendar-day me-1"></i> @Model.Deadline.ToString("dd MMM")
            </small>
            @if (Model.Priority != null)
            {
                <span class="badge @(Model.Priority.Level >= 4 ? "bg-danger" : (Model.Priority.Level == 3 ? "bg-warning text-dark" : "bg-info text-dark"))" style="font-size: 0.7rem;">
                    @Model.Priority.Name
                </span>
            }
        </div>
    </div>
</div>
