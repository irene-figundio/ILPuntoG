<div class="space-y-8">
    <section>
        <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4">Sedi & Progetti</h3>
        <div class="space-y-4">
            <select id="branchFilter" class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" onchange="refreshEvents()">
                <option value="">Tutte le Sedi</option>
                @if (ViewBag.AllBranches != null) {
                    var selectedId = ViewContext.HttpContext.Request.Cookies["SelectedBranchId"];
                    foreach (var b in (IEnumerable<Models.Branch>)ViewBag.AllBranches) {
                        <option value="@b.Id" selected="@(b.Id.ToString() == selectedId ? "selected" : null)">@b.Name</option>
                    }
                }
            </select>
            <select id="projectFilter" class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" onchange="refreshEvents()">
                <option value="">Tutti i Progetti</option>
                @if (ViewBag.Projects != null) {
                    foreach (var p in (IEnumerable<Models.Project>)ViewBag.Projects) { <option value="@p.Id">@p.Name</option> }
                }
            </select>
        </div>
    </section>

    <section>
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Calendari Google</h3>
            <span class="material-symbols-outlined text-gray-300 text-sm">settings</span>
        </div>
        <div id="calendar-list" class="space-y-2">
            <div class="flex items-center gap-3 py-2 animate-pulse">
                <div class="size-4 bg-gray-200 dark:bg-gray-800 rounded"></div>
                <div class="h-3 w-24 bg-gray-100 dark:bg-gray-800 rounded"></div>
            </div>
        </div>
        <div id="google-connect-container" class="mt-4 hidden">
            <a href="/Calendar/ConnectGoogle" class="flex items-center justify-center gap-2 w-full py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl text-xs font-bold hover:bg-gray-50 transition-all">
                <img src="https://www.google.com/favicon.ico" class="size-3" alt="Google">
                Connetti Google
            </a>
        </div>
    </section>

    <section class="pt-8 border-t border-gray-100 dark:border-gray-800">
        <div class="p-4 bg-primary/5 rounded-2xl border border-primary/10">
            <h4 class="text-xs font-black text-primary mb-1 uppercase tracking-tighter">Sync Info</h4>
            <p class="text-[10px] text-gray-500 leading-relaxed font-medium">
                Gli eventi vengono sincronizzati bidirezionalmente con Google Calendar in tempo reale.
            </p>
        </div>
    </section>
</div>
