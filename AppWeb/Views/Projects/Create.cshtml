@model Models.Project

@{
    ViewData["Title"] = "Nuovo Progetto";
}

<div class="p-8 max-w-2xl mx-auto">
    <div class="flex items-center gap-2 text-gray-500 mb-6 text-sm">
        <a href="/Projects" class="hover:text-primary transition-colors">Progetti</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <span class="font-bold text-gray-900 dark:text-white">Nuovo Progetto</span>
    </div>

    <div class="bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
        <div class="bg-primary p-6 text-white flex items-center gap-4">
            <div class="size-12 bg-white/20 rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined">create_new_folder</span>
            </div>
            <div>
                <h2 class="text-xl font-black">Crea Progetto</h2>
                <p class="text-white/80 text-xs">Aggiungi una nuova iniziativa al portfolio.</p>
            </div>
        </div>

        <div class="p-8">
            <form asp-action="Create" class="space-y-6">
                <div>
                    <label asp-for="Name" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Nome Progetto</label>
                    <input asp-for="Name" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" placeholder="Es. Ristrutturazione Uffici" />
                    <span asp-validation-for="Name" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                </div>

                <div>
                    <label asp-for="BranchId" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Sede</label>
                    <select asp-for="BranchId" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="ViewBag.Branches">
                        <option value="">Seleziona una sede...</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                </div>

                <div>
                    <label asp-for="Status" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Stato</label>
                    <select asp-for="Status" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="Html.GetEnumSelectList<Models.ProjectStatus>()"></select>
                    <span asp-validation-for="Status" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                </div>

                <div class="pt-4 flex items-center justify-end gap-3">
                    <a href="/Projects" class="px-6 py-2.5 text-sm font-bold text-gray-400 hover:text-gray-600 transition-colors">Annulla</a>
                    <button type="submit" class="bg-primary hover:bg-primary/90 text-white px-8 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 transition-all">
                        Crea Progetto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
