@model Models.Project

@{
    ViewData["Title"] = "Nuovo Progetto";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Progetti</a></li>
                <li class="breadcrumb-item active" aria-current="page">Nuovo Progetto</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="fas fa-folder-plus me-2"></i>Nuovo Progetto</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Nome Progetto</label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Es. Ristrutturazione" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BranchId" class="form-label fw-bold">Sede</label>
                        <select asp-for="BranchId" class="form-select shadow-sm" asp-items="ViewBag.Branches">
                            <option value="">Seleziona una sede...</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold">Stato Iniziale</label>
                        <select asp-for="Status" class="form-select shadow-sm" asp-items="Html.GetEnumSelectList<Models.ProjectStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-light px-4">Annulla</a>
                        <button type="submit" class="btn btn-primary px-5 fw-bold">Crea Progetto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
