@model IEnumerable<Models.Project>

@{
    ViewData["Title"] = "Gestione Progetti";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-project-diagram me-2"></i>Gestione Progetti</h2>
    <a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary btn-lg shadow-sm">
        <i class="fas fa-plus me-1"></i> Nuovo Progetto
    </a>
</div>

<div class="card bg-light border-0 mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold"><i class="fas fa-filter me-1"></i> Filtra per Sede:</label>
            </div>
            <div class="col-auto">
                <select name="branchId" class="form-select" asp-items="ViewBag.Branches" onchange="this.form.submit()">
                    <option value="">Tutte le sedi</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title text-primary fw-bold mb-0">@item.Name</h5>
                        <span class="badge @(item.Status == Models.ProjectStatus.Completed ? "bg-success" : (item.Status == Models.ProjectStatus.InProgress ? "bg-warning" : "bg-secondary"))">
                            @item.Status
                        </span>
                    </div>
                    <p class="card-text text-muted small mb-3">
                        <i class="fas fa-calendar-alt me-1"></i> Creato in: @(item.Branch?.Name ?? "N/A")
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                            <i class="fas fa-edit me-1"></i> Modifica
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Sicuro?')">
                            <i class="fas fa-trash"></i>
                        </a>
                        <a asp-controller="TodoTasks" asp-action="Index" asp-route-projectId="@item.Id" class="btn btn-info btn-sm text-white ms-auto">
                            <i class="fas fa-tasks me-1"></i> Attività
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="fas fa-folder-open fa-3x mb-3"></i>
        <h4>Nessun progetto trovato</h4>
        <p>Inizia creandone uno nuovo per questa sede!</p>
    </div>
}

<style>
    .transition-hover:hover {
        transform: scale(1.02);
        transition: transform 0.2s ease-in-out;
    }
</style>
