@{
    ViewData["Title"] = "Calendario Google";
    var now = DateTime.Now;
    // For the iframe, we'll use a placeholder or a common public one if not provided.
    // In a real app, this would be a setting or user-specific.
    var calendarUrl = "https://calendar.google.com/calendar/embed?src=en.italian%23holiday%40group.v.calendar.google.com&ctz=Europe%2FRome";
}

<main class="flex flex-col lg:flex-row h-full overflow-hidden">
    <!-- Left: Calendar Visualization -->
    <div class="flex-1 flex flex-col min-w-0 bg-white dark:bg-gray-900 border-r border-gray-100 dark:border-gray-800">
        <div class="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-black tracking-tight">Calendario Google</h1>
                <p class="text-xs text-gray-500">Visualizzazione integrata e sincronizzata.</p>
            </div>
            <button onclick="syncGoogle()" id="syncBtn" class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-xl text-xs font-black hover:bg-primary hover:text-white transition-all">
                <span class="material-symbols-outlined text-sm">sync</span>
                Sincronizza Ora
            </button>
        </div>

        <div class="flex-1 relative p-4">
            <iframe src="@calendarUrl" style="border-width:0" width="100%" height="100%" frameborder="0" scrolling="no" class="rounded-2xl shadow-inner bg-gray-50"></iframe>
        </div>
    </div>

    <!-- Right: Sidebar for Controls and Stats -->
    <aside class="w-full lg:w-80 bg-gray-50 dark:bg-background-dark flex flex-col shrink-0 overflow-y-auto">
        <div class="p-6 space-y-8">
            <section>
                <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4">Integrazione</h3>
                <div id="google-status-card" class="p-4 bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="size-10 bg-blue-50 dark:bg-blue-900/20 rounded-xl flex items-center justify-center text-blue-600">
                            <span class="material-symbols-outlined">account_circle</span>
                        </div>
                        <div>
                            <p class="text-xs font-black">Google Account</p>
                            <p id="connStatus" class="text-[10px] text-gray-400 font-bold uppercase">Verifica in corso...</p>
                        </div>
                    </div>
                    <div id="google-actions" class="space-y-2">
                        <!-- Dynamic Buttons -->
                    </div>
                </div>
            </section>

            <section>
                <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4">Prossimi Eventi</h3>
                <div id="upcoming-events" class="space-y-3">
                    <p class="text-center py-8 text-gray-400 text-xs italic bg-white/50 dark:bg-gray-800/30 rounded-2xl border border-dashed border-gray-200 dark:border-gray-700">
                        Sincronizza per vedere le attività recenti.
                    </p>
                </div>
            </section>
        </div>

        <div class="mt-auto p-6 border-t border-gray-100 dark:border-gray-800">
            <div class="p-4 bg-primary rounded-2xl text-white shadow-lg shadow-primary/20">
                <p class="text-xs font-black mb-1 uppercase opacity-80 tracking-tighter">Tip</p>
                <p class="text-[11px] font-medium leading-relaxed">
                    Le attività sincronizzate appariranno automaticamente nel tuo Kanban e nei report di sede.
                </p>
            </div>
        </div>
    </aside>
</main>

@section Scripts {
    <script>
        function refreshGoogleUI() {
            fetch('/Calendar/GetGoogleStatus')
                .then(r => r.json())
                .then(data => {
                    const statusText = document.getElementById('connStatus');
                    const actionsArea = document.getElementById('google-actions');

                    if (data.isConnected || data.IsConnected) {
                        statusText.innerText = "Collegato";
                        statusText.classList.add('text-green-500');
                        actionsArea.innerHTML = `
                            <button onclick="syncGoogle()" class="w-full py-2 bg-primary text-white text-[10px] font-black rounded-lg uppercase">Sincronizza</button>
                            <button onclick="disconnectGoogle()" class="w-full py-2 border border-red-100 text-red-500 text-[10px] font-black rounded-lg uppercase hover:bg-red-50">Scollega</button>
                        `;
                    } else {
                        statusText.innerText = "Non Collegato";
                        actionsArea.innerHTML = `
                            <button onclick="connectGoogle()" class="w-full py-2 bg-primary text-white text-[10px] font-black rounded-lg uppercase">Collega Google</button>
                        `;
                    }
                });
        }

        window.syncGoogle = function() {
            const btn = document.getElementById('syncBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span> Sincronizzazione...';
            btn.disabled = true;

            fetch('/Calendar/SyncGoogle', { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    alert(data.message || data.Message);
                    location.reload();
                })
                .catch(() => {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                });
        };

        window.connectGoogle = function() {
            fetch('/Calendar/ConnectGoogle', { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    alert(data.message || data.Message);
                    refreshGoogleUI();
                });
        };

        window.disconnectGoogle = function() {
            if (confirm('Scollegare Google Calendar?')) {
                fetch('/Calendar/DisconnectGoogle', { method: 'POST' }).then(() => refreshGoogleUI());
            }
        };

        $(document).ready(function() {
            refreshGoogleUI();
        });
    </script>
}
