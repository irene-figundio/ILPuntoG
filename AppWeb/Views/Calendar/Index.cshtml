@{
    ViewData["Title"] = "Calendario Interattivo";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
        <div>
            <h2 class="mb-0 fw-bold text-primary"><i class="fas fa-calendar-alt me-2"></i>Calendario & Kanban</h2>
            <p class="text-muted mb-0">Gestisci appuntamenti e scadenze trascinando gli elementi.</p>
        </div>
        <div id="google-integration-area" class="d-flex gap-2">
            <!-- Dynamic Buttons will appear here -->
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body py-2">
                    <form id="calendarFilters" class="row g-2 align-items-center">
                        <div class="col-md-2">
                            <select name="branchId" class="form-select form-select-sm">
                                <option value="">Sede: Tutte</option>
                                @foreach (var b in ViewBag.Branches) { <option value="@b.Id">@b.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="projectId" class="form-select form-select-sm">
                                <option value="">Progetto: Tutti</option>
                                @foreach (var p in ViewBag.Projects) { <option value="@p.Id">@p.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="userId" class="form-select form-select-sm">
                                <option value="">Utente: Tutti</option>
                                @foreach (var u in ViewBag.Users) { <option value="@u.Id">@u.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="clientId" class="form-select form-select-sm">
                                <option value="">Cliente: Tutti</option>
                                @foreach (var c in ViewBag.Clients) { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-sm btn-primary w-100" onclick="applyFilters()">Filtra</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div id="calendar"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                locale: 'it',
                editable: true,
                droppable: true,
                events: function(info, successCallback, failureCallback) {
                    const params = new URLSearchParams(new FormData(document.getElementById('calendarFilters'))).toString();
                    fetch('/Calendar/GetEvents?' + params)
                        .then(r => r.json())
                        .then(data => successCallback(data))
                        .catch(err => failureCallback(err));
                },
                selectable: true,
                select: function(info) {
                    $('#createModal').modal('show');
                    $('#createStart').val(info.startStr.split('T')[0]);
                },
                eventClick: function(info) {
                    const props = info.event.extendedProps;
                    if (props.type === 'task') {
                         window.location.href = '/TodoTasks/Edit/' + props.dbId;
                    } else if (props.type === 'appointment') {
                         openEditAppointment(props.dbId, info.event.title, info.event.start);
                    }
                },
                eventDrop: function(info) {
                    updateEvent(info.event, info.event.start);
                },
                eventResize: function(info) {
                    var duration = null;
                    if (info.event.end) {
                        var diff = info.event.end - info.event.start;
                        var hours = Math.floor(diff / 3600000);
                        var minutes = Math.floor((diff % 3600000) / 60000);
                        duration = hours.toString().padStart(2, '0') + ':' + minutes.toString().padStart(2, '0') + ':00';
                    }
                    updateEvent(info.event, info.event.start, null, duration);
                }
            });
            calendar.render();

            function updateEvent(event, newDate, newStatus, duration) {
                var data = {
                    type: event.extendedProps.type,
                    dbId: event.extendedProps.dbId,
                    newDate: newDate.toISOString(),
                    status: newStatus,
                    duration: duration
                };

                fetch('/Calendar/UpdateEvent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(data)
                }).then(response => {
                    if (response.ok) {
                        calendar.refetchEvents();
                    } else {
                        alert('Errore durante l\'aggiornamento');
                        calendar.refetchEvents();
                    }
                });
            }

            // Google Integration Logic
            function refreshGoogleUI() {
                fetch('/Calendar/GetGoogleStatus')
                    .then(r => r.json())
                    .then(data => {
                        const area = document.getElementById('google-integration-area');
                        if (data.isConnected || data.IsConnected) {
                            area.innerHTML = `
                                <button class="btn btn-outline-success shadow-sm" onclick="syncGoogle()">
                                    <i class="fab fa-google me-1"></i> Sincronizza ora
                                </button>
                                <button class="btn btn-outline-danger shadow-sm" onclick="disconnectGoogle()">
                                    <i class="fas fa-unlink"></i>
                                </button>
                            `;
                        } else {
                            area.innerHTML = `
                                <button class="btn btn-primary shadow-sm" onclick="connectGoogle()">
                                    <i class="fab fa-google me-2"></i> Collega Google Calendar
                                </button>
                            `;
                        }
                    });
            }

            window.connectGoogle = function() {
                fetch('/Calendar/ConnectGoogle', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        alert(data.message || data.Message);
                        refreshGoogleUI();
                    });
            };

            window.syncGoogle = function() {
                const area = document.getElementById('google-integration-area');
                const originalHtml = area.innerHTML;
                area.innerHTML = '<span class="text-primary"><i class="fas fa-sync fa-spin me-2"></i>Sincronizzazione...</span>';

                fetch('/Calendar/SyncGoogle', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        alert(data.message || data.Message);
                        refreshGoogleUI();
                        calendar.refetchEvents();
                    });
            };

            window.disconnectGoogle = function() {
                if (confirm('Vuoi scollegare Google Calendar?')) {
                    fetch('/Calendar/DisconnectGoogle', { method: 'POST' })
                        .then(() => refreshGoogleUI());
                }
            };

            refreshGoogleUI();

            window.applyFilters = function() {
                calendar.refetchEvents();
            };
        });
    </script>
}

<!-- Create Modal Choice -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crea Nuovo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <input type="hidden" id="createStart" />
                <div class="d-grid gap-3">
                    <button class="btn btn-lg btn-outline-primary" onclick="openCreate('task')">
                        <i class="fas fa-tasks me-2"></i>Nuova Attività (Task)
                    </button>
                    <button class="btn btn-lg btn-outline-info" onclick="openCreate('appointment')">
                        <i class="fas fa-calendar-check me-2"></i>Nuovo Appuntamento
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Appointment Edit Modal -->
<div class="modal fade" id="apptEditModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="apptEditTitle">Modifica Appuntamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Cosa desideri fare con questo appuntamento?</p>
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-danger" onclick="deleteAppointment()">
                        <i class="fas fa-trash me-2"></i>Elimina Appuntamento
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="apptEditId" />
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openCreate(type) {
        const start = document.getElementById('createStart').value;
        if (type === 'task') {
            window.location.href = '/TodoTasks/Create?deadline=' + start;
        } else {
            window.location.href = '/Appointments/Create?startTime=' + start;
        }
    }

    function openEditAppointment(id, title, start) {
        $('#apptEditTitle').text(title);
        $('#apptEditId').val(id);
        $('#apptEditModal').modal('show');
    }

    function deleteAppointment() {
        const id = document.getElementById('apptEditId').value;
        if (confirm('Sicuro di voler eliminare questo appuntamento?')) {
            const data = new URLSearchParams();
            data.append('id', id);
            fetch('/Appointments/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: data
            })
            .then(() => {
                $('#apptEditModal').modal('hide');
                location.reload();
            });
        }
    }
</script>

<style>
    #calendar {
        height: 700px;
    }
    .fc-event {
        cursor: pointer;
        padding: 2px 5px;
        font-size: 0.85rem;
    }
</style>
