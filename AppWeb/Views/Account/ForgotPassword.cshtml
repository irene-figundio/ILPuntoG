@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Recupero Password - Il Punto G</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.3.2/cosmo/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <style>
        body { background-color: #f8f9fa; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { border-radius: 1rem; width: 400px; }
        .card-header { background-color: #2780e3; color: white; text-align: center; padding: 1.5rem; border-radius: 1rem 1rem 0 0 !important; }
    </style>
</head>
<body>
    <div class="card shadow-lg">
        <div class="card-header">
            <h4>Recupero Password</h4>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info small">@ViewBag.Message</div>
                @if (ViewBag.DebugToken != null)
                {
                    <div class="mt-3 p-2 bg-light border rounded small">
                        <strong>Simulazione Email:</strong><br>
                        Clicca qui per resettare:<br>
                        <a href="/Account/ResetPassword?username=@ViewBag.DebugToken.username&token=@ViewBag.DebugToken.token">Resetta Password</a>
                    </div>
                }
                <div class="text-center mt-3">
                    <a href="/Account/Login" class="btn btn-secondary btn-sm">Torna alla Login</a>
                </div>
            }
            else
            {
                <form action="/Account/ForgotPassword" method="post">
                    <div class="mb-3">
                        <label class="form-label">Inserisci la tua email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Invia link di reset</button>
                    <div class="text-center mt-3">
                        <a href="/Account/Login" class="text-decoration-none small">Torna alla Login</a>
                    </div>
                </form>
            }
        </div>
    </div>
</body>
</html>
