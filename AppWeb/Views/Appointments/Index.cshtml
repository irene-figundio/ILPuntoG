@model IEnumerable<Models.Appointment>

@{
    ViewData["Title"] = "Gestione Appuntamenti";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-check me-2"></i>Gestione Appuntamenti</h2>
    <a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary btn-lg shadow-sm">
        <i class="fas fa-plus me-1"></i> Nuovo Appuntamento
    </a>
</div>

<div class="card bg-light border-0 mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold"><i class="fas fa-filter me-1"></i> Filtra per Sede:</label>
            </div>
            <div class="col-auto">
                <select name="branchId" class="form-select" asp-items="ViewBag.Branches" onchange="this.form.submit()">
                    <option value="">Tutte le sedi</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold mb-3">@item.Description</h5>
                    <div class="mb-2">
                        <span class="badge bg-info text-dark">
                            <i class="fas fa-clock me-1"></i> @item.StartTime.ToString("f")
                        </span>
                    </div>
                    <p class="card-text text-muted small mb-1">
                        <i class="fas fa-hourglass-half me-1"></i> Durata: @item.Duration.ToString(@"hh\:mm")
                    </p>
                    <p class="card-text text-muted small mb-1">
                        <i class="fas fa-building me-1"></i> Sede: @(item.Branch?.Name ?? "N/A")
                    </p>
                    @if (item.Project != null)
                    {
                        <p class="card-text text-muted small">
                            <i class="fas fa-project-diagram me-1"></i> Progetto: @item.Project.Name
                        </p>
                    }
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <div class="d-flex gap-2">
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm w-100" onclick="return confirm('Sicuro?')">
                            <i class="fas fa-trash me-1"></i> Elimina
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="fas fa-calendar-times fa-3x mb-3"></i>
        <h4>Nessun appuntamento trovato</h4>
        <p>Inizia creandone uno nuovo!</p>
    </div>
}

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
