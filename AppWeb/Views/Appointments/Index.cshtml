@model IEnumerable<Models.Appointment>
@{
    ViewData["Title"] = "Gestione Appuntamenti";
}

<div class="p-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-black tracking-tight mb-1">Gestione Appuntamenti</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Organizza incontri, sopralluoghi e riunioni di progetto.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="location.href='/Appointments/Create?branchId=@ViewBag.BranchId'" class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-lg text-sm font-bold shadow-md hover:bg-primary/90 transition-all">
                <span class="material-symbols-outlined text-lg">add_circle</span> Nuovo Appuntamento
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-[#1a202c] p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800 flex flex-wrap items-center gap-4 mb-8">
        <form method="get" asp-action="Index" class="flex flex-wrap items-center gap-4 w-full">
            <div class="flex items-center gap-2 min-w-[200px]">
                <span class="material-symbols-outlined text-gray-400">filter_list</span>
                <select name="branchId" class="bg-transparent border-none text-sm font-bold focus:ring-0 cursor-pointer" onchange="this.form.submit()">
                    <option value="">Tutte le Sedi</option>
                    @foreach (var branch in (SelectList)ViewBag.Branches)
                    {
                        @if (ViewBag.BranchId?.ToString() == branch.Value)
                        {
                            <option value="@branch.Value" selected>@branch.Text</option>
                        }
                        else
                        {
                            <option value="@branch.Value">@branch.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="h-8 w-px bg-gray-200 dark:bg-gray-700 hidden md:block"></div>
            <div class="relative flex-1 min-w-[200px]">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
                <input id="apptSearch" class="w-full pl-10 pr-4 py-2 bg-gray-50 dark:bg-gray-800 border-none rounded-lg text-sm focus:ring-2 focus:ring-primary" placeholder="Cerca appuntamenti..." type="text" />
            </div>
        </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="apptGrid">
        @foreach (var item in Model)
        {
            <div class="appt-card bg-white dark:bg-[#1a202c] p-6 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-md transition-all group" data-title="@item.Description.ToLower()">
                <div class="flex justify-between items-start mb-4">
                    <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">event</span>
                    </div>
                    <button onclick="if(confirm('Eliminare?')) location.href='/Appointments/Delete/@item.Id'" class="text-gray-300 hover:text-red-500 transition-colors">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
                <h3 class="text-lg font-bold mb-2 group-hover:text-primary transition-colors">@item.Description</h3>
                <div class="space-y-3 mt-4 pt-4 border-t border-gray-50 dark:border-gray-800">
                    <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-base">schedule</span>
                        <span class="font-bold text-gray-900 dark:text-white">@item.StartTime.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-base">hourglass_empty</span>
                        <span>Durata: @item.Duration.ToString(@"hh\:mm")</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-base">location_on</span>
                        <span>@(item.Branch?.Name ?? "N/A")</span>
                    </div>
                    @if (item.Project != null)
                    {
                        <div class="mt-2 flex items-center gap-2 px-2 py-1 bg-primary/5 rounded text-[10px] font-bold text-primary uppercase">
                            <span class="material-symbols-outlined text-xs">folder</span>
                            @item.Project.Name
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="mt-12 text-center py-12 bg-white dark:bg-[#1a202c] rounded-2xl border-2 border-dashed border-gray-200 dark:border-gray-800">
            <span class="material-symbols-outlined text-4xl text-gray-300 mb-2">calendar_today</span>
            <p class="text-gray-500">Nessun appuntamento in programma.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#apptSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#apptGrid .appt-card").filter(function() {
                    $(this).toggle($(this).data("title").indexOf(value) > -1)
                });
            });
        });
    </script>
}
