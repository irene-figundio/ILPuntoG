@model Models.Appointment

<div class="container mt-4">
    <h2>Nuovo Appuntamento</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label">Descrizione</label>
                    <input asp-for="Description" class="form-control" required />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="StartTime" class="control-label">Data e Ora</label>
                    <input asp-for="StartTime" class="form-control" type="datetime-local" required />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Duration" class="control-label">Durata (ore:minuti)</label>
                    <input asp-for="Duration" class="form-control" type="time" required />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="BranchId" class="control-label">Sede</label>
                    <select asp-for="BranchId" class="form-select" asp-items="ViewBag.Branches"></select>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="ProjectId" class="control-label">Progetto (Opzionale)</label>
                    <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.Projects">
                        <option value="">Nessun progetto</option>
                    </select>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success">Salva</button>
                    <a asp-action="Index" class="btn btn-secondary">Annulla</a>
                </div>
            </form>
        </div>
    </div>
</div>
