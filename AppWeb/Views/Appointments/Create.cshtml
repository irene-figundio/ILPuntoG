@model Models.Appointment

@{
    ViewData["Title"] = "Nuovo Appuntamento";
}

<div class="p-4 lg:p-8 max-w-2xl mx-auto">
    <div class="flex items-center gap-2 text-gray-500 mb-6 text-sm">
        <a href="/Appointments" class="hover:text-primary transition-colors">Appuntamenti</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <span class="font-bold text-gray-900 dark:text-white">Nuovo Appuntamento</span>
    </div>

    <div class="bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
        <div class="bg-primary p-6 text-white flex items-center gap-4">
            <div class="size-12 bg-white/20 rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined">calendar_add_on</span>
            </div>
            <div>
                <h2 class="text-xl font-black">Crea Appuntamento</h2>
                <p class="text-white/80 text-xs">Pianifica un nuovo evento o sopralluogo.</p>
            </div>
        </div>

        <div class="p-8">
            <form asp-action="Create" class="space-y-6">
                <div>
                    <label asp-for="Description" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Descrizione / Titolo</label>
                    <input asp-for="Description" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" placeholder="Es. Sopralluogo Cantiere" required />
                    <span asp-validation-for="Description" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="StartTime" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Data e Ora</label>
                        <input asp-for="StartTime" type="datetime-local" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="StartTime" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                    </div>
                    <div>
                        <label asp-for="Duration" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Durata</label>
                        <input asp-for="Duration" type="time" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" value="01:00" required />
                        <span asp-validation-for="Duration" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="BranchId" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Sede</label>
                        <select asp-for="BranchId" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="ViewBag.Branches"></select>
                    </div>
                    <div>
                        <label asp-for="ProjectId" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Progetto (Opzionale)</label>
                        <select asp-for="ProjectId" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="ViewBag.Projects">
                            <option value="">Nessuno</option>
                        </select>
                    </div>
                </div>

                <div class="pt-4 flex items-center justify-end gap-3">
                    <a href="/Appointments" class="px-6 py-2.5 text-sm font-bold text-gray-400 hover:text-gray-600 transition-colors">Annulla</a>
                    <button type="submit" class="bg-primary hover:bg-primary/90 text-white px-8 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 transition-all">
                        Crea Appuntamento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
