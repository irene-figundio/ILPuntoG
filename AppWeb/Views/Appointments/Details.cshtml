@model Models.Appointment
@{
    ViewData["Title"] = "Dettagli Appuntamento";
}

<div class="p-4 lg:p-8 max-w-4xl mx-auto">
    <div class="flex items-center gap-2 text-gray-500 mb-6 text-sm">
        <a href="/Appointments" class="hover:text-primary transition-colors">Appuntamenti</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <span class="font-bold text-gray-900 dark:text-white">Dettagli</span>
    </div>

    <div class="bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
        <div class="bg-primary p-6 text-white flex items-center gap-4">
            <div class="size-14 bg-white/20 rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">event</span>
            </div>
            <div>
                <h1 class="text-2xl font-black">@Model.Description</h1>
                <p class="text-white/80 text-xs">@Model.StartTime.ToString("dddd, dd MMMM yyyy")</p>
            </div>
        </div>

        <div class="p-6 lg:p-8 space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <section class="space-y-6">
                    <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4 ml-1">Orari e Luogo</h3>
                    <div class="space-y-4">
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-gray-400">schedule</span>
                            <div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase">Orario di Inizio</p>
                                <p class="text-sm font-bold">@Model.StartTime.ToString("HH:mm")</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-gray-400">hourglass_top</span>
                            <div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase">Durata</p>
                                <p class="text-sm font-bold">@Model.Duration.ToString(@"hh\:mm")</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-gray-400">location_on</span>
                            <div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase">Sede</p>
                                <p class="text-sm font-bold">@(Model.Branch?.Name ?? "N/A")</p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="space-y-6">
                    <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4 ml-1">Contesto</h3>
                    <div class="space-y-4">
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-gray-400">folder</span>
                            <div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase">Progetto</p>
                                <p class="text-sm font-bold text-primary cursor-pointer hover:underline" onclick="location.href='/Projects/Details/@Model.ProjectId'">@(Model.Project?.Name ?? "Nessun progetto associato")</p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="pt-8 border-t border-gray-100 dark:border-gray-800 flex justify-end gap-3">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Eliminare questo appuntamento?')">
                    <button type="submit" class="text-red-500 text-sm font-bold px-6 py-2">Elimina</button>
                </form>
                <button onclick="history.back()" class="bg-primary text-white px-10 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 hover:bg-primary/90 transition-all">Torna Indietro</button>
            </div>
        </div>
    </div>
</div>
