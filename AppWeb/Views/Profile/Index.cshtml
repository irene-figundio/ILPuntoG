@{
    ViewData["Title"] = "Il Mio Profilo";
}

<div class="p-4 lg:p-8 max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row gap-8">
        <!-- Sidebar: User Info -->
        <div class="w-full md:w-80 shrink-0">
            <div class="bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 p-8 text-center">
                <div class="size-24 rounded-3xl bg-primary/10 flex items-center justify-center text-primary mx-auto mb-6">
                    <span class="material-symbols-outlined text-5xl">account_circle</span>
                </div>
                <h2 class="text-2xl font-black mb-1">@User.Identity?.Name</h2>
                <p class="text-gray-500 text-sm mb-4">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-black uppercase tracking-widest">
                    @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </span>
            </div>
        </div>

        <!-- Main: Security / Settings -->
        <div class="flex-1 space-y-8">
            <div class="bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
                <div class="bg-gray-50 dark:bg-gray-800/50 p-6 border-b border-gray-100 dark:border-gray-800 flex items-center gap-3">
                    <span class="material-symbols-outlined text-warning">lock_reset</span>
                    <h3 class="font-bold text-lg">Sicurezza Account</h3>
                </div>

                <div class="p-8">
                    @if (ViewBag.Message != null)
                    {
                        <div class="bg-green-50 dark:bg-green-900/20 text-green-600 dark:text-green-400 p-4 rounded-xl text-xs font-bold mb-6 border border-green-100 dark:border-green-900/30">
                            @ViewBag.Message
                        </div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-xl text-xs font-bold mb-6 border border-red-100 dark:border-red-900/30">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post" class="space-y-6">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Vecchia Password</label>
                            <input type="password" name="oldPassword" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" required />
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Nuova Password</label>
                                <input type="password" name="newPassword" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" required minlength="6" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Conferma Nuova Password</label>
                                <input type="password" name="confirmPassword" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" required minlength="6" />
                            </div>
                        </div>
                        <div class="pt-4">
                            <button type="submit" class="bg-primary hover:bg-primary/90 text-white px-8 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 transition-all">
                                Aggiorna Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
