@{
    ViewData["Title"] = "Mio Profilo";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span class="material-symbols-outlined text-6xl text-primary mb-4">account_circle</span>
                    </div>
                    <h4 class="fw-bold">@User.Identity?.Name</h4>
                    <p class="text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                    <span class="badge bg-info text-dark">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><span class="material-symbols-outlined text-warning me-2">key</span>Cambia Password</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">@ViewBag.Message</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }
                    <form asp-action="ChangePassword" method="post">
                        <div class="mb-3">
                            <label class="form-label">Vecchia Password</label>
                            <input type="password" name="oldPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nuova Password</label>
                            <input type="password" name="newPassword" class="form-control" required minlength="6" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Conferma Nuova Password</label>
                            <input type="password" name="confirmPassword" class="form-control" required minlength="6" />
                        </div>
                        <button type="submit" class="btn btn-warning fw-bold px-4">Aggiorna Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
