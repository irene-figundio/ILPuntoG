@model Models.Branch

@{
    ViewData["Title"] = "Nuova Sede";
}

<div class="p-4 lg:p-8 max-w-2xl mx-auto">
    <div class="flex items-center gap-2 text-gray-500 mb-6 text-sm">
        <a href="/Branches" class="hover:text-primary transition-colors">Sedi</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <span class="font-bold text-gray-900 dark:text-white">Nuova Sede</span>
    </div>

    <div class="bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
        <div class="bg-primary p-6 text-white flex items-center gap-4">
            <div class="size-12 bg-white/20 rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined">add_location_alt</span>
            </div>
            <div>
                <h2 class="text-xl font-black">Nuova Sede</h2>
                <p class="text-white/80 text-xs">Aggiungi un nuovo punto operativo.</p>
            </div>
        </div>

        <div class="p-8">
            <form asp-action="Create" class="space-y-6">
                <div>
                    <label asp-for="Name" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Nome Sede</label>
                    <input asp-for="Name" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" placeholder="Es. Milano Centrale" required />
                    <span asp-validation-for="Name" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                </div>

                <div>
                    <label asp-for="Address" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Indirizzo</label>
                    <textarea asp-for="Address" rows="3" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" placeholder="Via Roma 1, Milano"></textarea>
                    <span asp-validation-for="Address" class="text-red-500 text-[10px] font-bold mt-1 ml-1"></span>
                </div>

                <div class="pt-4 flex items-center justify-end gap-3">
                    <a href="/Branches" class="px-6 py-2.5 text-sm font-bold text-gray-400 hover:text-gray-600 transition-colors">Annulla</a>
                    <button type="submit" class="bg-primary hover:bg-primary/90 text-white px-8 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 transition-all">
                        Crea Sede
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
