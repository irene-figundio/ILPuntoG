@model IEnumerable<Models.Branch>
@{
    ViewData["Title"] = "Gestione Sedi";
}

<div class="p-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-black tracking-tight mb-1">Gestione Sedi</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Visualizza e gestisci le sedi operative della tua azienda.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="location.href='/Branches/Create'" class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-lg text-sm font-bold shadow-md hover:bg-primary/90 transition-all">
                <span class="material-symbols-outlined text-lg">add_location</span> Nuova Sede
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <div class="bg-white dark:bg-[#1a202c] p-6 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-md transition-all group">
                <div class="flex justify-between items-start mb-4">
                    <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">domain</span>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="location.href='/Branches/Edit/@item.Id'" class="text-gray-300 hover:text-primary transition-colors">
                            <span class="material-symbols-outlined">edit</span>
                        </button>
                        <button onclick="if(confirm('Sicuro di voler eliminare questa sede?')) location.href='/Branches/Delete/@item.Id'" class="text-gray-300 hover:text-red-500 transition-colors">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </div>
                </div>
                <h3 class="text-lg font-bold mb-2 group-hover:text-primary transition-colors cursor-pointer" onclick="location.href='/Branches/Details/@item.Id'">@item.Name</h3>
                <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm mb-6">
                    <span class="material-symbols-outlined text-base">location_on</span>
                    @item.Address
                </div>
                <div class="pt-4 border-t border-gray-50 dark:border-gray-800 flex justify-between items-center">
                    <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Capacità</div>
                    <span class="text-sm font-black text-primary">Attiva</span>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="mt-12 text-center py-12 bg-white dark:bg-[#1a202c] rounded-2xl border-2 border-dashed border-gray-200 dark:border-gray-800">
            <span class="material-symbols-outlined text-4xl text-gray-300 mb-2">location_off</span>
            <p class="text-gray-500">Nessuna sede configurata.</p>
        </div>
    }
</div>
