@model IEnumerable<Models.Branch>

<div class="container mt-4">
    <h2>Gestione Sedi (Branches)</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Nuova Sede</a>
    </p>

    <table class="table table-striped table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Nome</th>
                <th>Indirizzo</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Address</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Modifica</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Sicuro?')">Elimina</a>
                            <a asp-controller="Projects" asp-action="Index" asp-route-branchId="@item.Id" class="btn btn-sm btn-info">Progetti</a>
                            <a asp-controller="Appointments" asp-action="Index" asp-route-branchId="@item.Id" class="btn btn-sm btn-secondary">Appuntamenti</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
