@model IEnumerable<Models.Branch>

@{
    ViewData["Title"] = "Gestione Sedi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-building me-2"></i>Gestione Sedi</h2>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
        <i class="fas fa-plus me-1"></i> Nuova Sede
    </a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold">@item.Name</h5>
                    <p class="card-text text-muted">
                        <i class="fas fa-map-marker-alt me-2"></i>@item.Address
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Sicuro?')">
                            <i class="fas fa-trash"></i>
                        </a>
                        <a asp-controller="Projects" asp-action="Index" asp-route-branchId="@item.Id" class="btn btn-info btn-sm text-white">
                            Progetti
                        </a>
                        <a asp-controller="Appointments" asp-action="Index" asp-route-branchId="@item.Id" class="btn btn-secondary btn-sm">
                            Appuntamenti
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="fas fa-info-circle fa-3x mb-3"></i>
        <h4>Nessuna sede trovata</h4>
        <p>Inizia creandone una nuova!</p>
    </div>
}

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
