@model IEnumerable<Models.TodoTask>

<div class="container mt-4">
    <h2>Attività / To-Do</h2>

    <form method="get" asp-action="Index" class="row g-3 align-items-center mb-4">
        <div class="col-auto">
            <label class="col-form-label">Filtra per Progetto:</label>
        </div>
        <div class="col-auto">
            <select name="projectId" class="form-select" asp-items="ViewBag.Projects" onchange="this.form.submit()">
                <option value="">Tutti i progetti</option>
            </select>
        </div>
    </form>

    <p>
        <a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-primary">Nuova Attività</a>
    </p>

    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th>Titolo</th>
                <th>Priorità</th>
                <th>Scadenza</th>
                <th>Stato</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.Priority == Models.TaskPriority.Urgent ? "table-danger" : "")">
                    <td>@item.Title</td>
                    <td><span class="badge @(item.Priority == Models.TaskPriority.High ? "bg-warning" : "bg-info")">@item.Priority</span></td>
                    <td>@(item.Deadline?.ToString("d") ?? "-")</td>
                    <td>@item.Status</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Modifica</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Sicuro?')">Elimina</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
