@model IEnumerable<Models.TodoTask>

@{
    ViewData["Title"] = "Gestione Attività";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tasks me-2"></i>Gestione Attività</h2>
    <a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-primary btn-lg shadow-sm">
        <i class="fas fa-plus me-1"></i> Nuova Attività
    </a>
</div>

<div class="card bg-light border-0 mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold"><i class="fas fa-filter me-1"></i> Filtra per Progetto:</label>
            </div>
            <div class="col-auto">
                <select name="projectId" class="form-select" asp-items="ViewBag.Projects" onchange="this.form.submit()">
                    <option value="">Tutti i progetti</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @{
        var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
    }
    @foreach (var item in Model)
    {
        bool isMyTask = item.TaskAssignments.Any(ta => ta.UserId == currentUserId);
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 transition-hover border-start border-4 @(item.Priority?.LevelId >= 4 ? "border-danger" : (item.Priority?.LevelId == 3 ? "border-warning" : "border-info"))">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title text-primary fw-bold mb-0">
                            @if (isMyTask) { <span class="badge bg-primary me-2">MIO</span> }
                            @item.Title
                        </h5>
                        <span class="badge @(item.Status == Models.TodoStatus.Completed ? "bg-success" : (item.Status == Models.TodoStatus.InProgress ? "bg-warning" : "bg-secondary"))">
                            @item.Status
                        </span>
                    </div>
                    <p class="card-text text-muted small mb-3">@item.Description</p>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-light text-dark border">
                            <i class="fas fa-exclamation-circle me-1"></i> @(item.Priority?.Name ?? "N/A")
                        </span>
                        <span class="badge bg-light text-dark border">
                            <i class="fas fa-calendar-day me-1"></i> Scadenza: @item.Deadline.ToShortDateString()
                        </span>
                    </div>

                    <p class="card-text text-muted small mb-0">
                        <i class="fas fa-user me-1"></i> Assegnati: @string.Join(", ", item.TaskAssignments.Select(a => a.User?.Name).Where(n => n != null))
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                            <i class="fas fa-edit me-1"></i> Modifica
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Sicuro?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="fas fa-clipboard-check fa-3x mb-3"></i>
        <h4>Nessuna attività trovata</h4>
        <p>Inizia creandone una nuova!</p>
    </div>
}

<style>
    .transition-hover:hover {
        transform: scale(1.02);
        transition: transform 0.2s ease-in-out;
    }
</style>
