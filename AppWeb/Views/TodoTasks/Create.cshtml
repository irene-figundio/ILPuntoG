@model Models.TodoTask
@{
    ViewData["Title"] = "Nuova Attività";
}

<div class="p-4 lg:p-8 max-w-4xl mx-auto">
    <div class="flex items-center gap-2 text-gray-500 mb-6 text-sm">
        <a href="/TodoTasks" class="hover:text-primary transition-colors">Attività</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <span class="font-bold text-gray-900 dark:text-white">Nuova Attività</span>
    </div>

    <div class="bg-white dark:bg-[#1a202c] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
        <div class="bg-primary p-6 text-white flex items-center gap-4">
            <div class="size-12 bg-white/20 rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined">add_task</span>
            </div>
            <div>
                <h2 class="text-xl font-black">Crea Attività</h2>
                <p class="text-white/80 text-xs">Assegna un nuovo compito al team.</p>
            </div>
        </div>

        <div class="p-6 lg:p-8">
            <form asp-action="Create" method="post" class="space-y-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Column 1 -->
                    <div class="space-y-6">
                        <div>
                            <label asp-for="Title" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Titolo</label>
                            <input asp-for="Title" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" placeholder="Cosa c'è da fare?" required />
                        </div>

                        <div>
                            <label asp-for="Description" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Descrizione</label>
                            <textarea asp-for="Description" rows="4" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" placeholder="Dettagli dell'attività..."></textarea>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label asp-for="ProjectId" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Progetto</label>
                                <select asp-for="ProjectId" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="ViewBag.Projects"></select>
                            </div>
                            <div>
                                <label asp-for="ClientId" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Cliente</label>
                                <select asp-for="ClientId" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="ViewBag.Clients">
                                    <option value="">Nessuno</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2 -->
                    <div class="space-y-6">
                        <div>
                            <label asp-for="Deadline" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Scadenza</label>
                            <input asp-for="Deadline" type="date" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label asp-for="PriorityId" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Priorità</label>
                                <select asp-for="PriorityId" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="ViewBag.Priorities"></select>
                            </div>
                            <div>
                                <label asp-for="TaskTypeId" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Tipo</label>
                                <select asp-for="TaskTypeId" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all" asp-items="ViewBag.TaskTypes"></select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Assegna a Collaboratori</label>
                            <select name="SelectedUserIds" multiple class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-primary transition-all h-32" asp-items="ViewBag.Users"></select>
                            <p class="text-[10px] text-gray-400 mt-1 italic">Tieni premuto Ctrl/Cmd per selezioni multiple.</p>
                        </div>

                        <div class="flex items-center gap-3 p-4 bg-primary/5 rounded-xl border border-primary/10">
                            <input type="checkbox" name="AssignToAll" id="assignAll" value="true" class="rounded text-primary focus:ring-primary h-5 w-5" />
                            <label for="assignAll" class="text-xs font-bold text-gray-700 dark:text-gray-300">Assegna a tutto il team della sede</label>
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-gray-50 dark:border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2">
                            <input asp-for="IsRecurring" class="rounded text-primary focus:ring-primary h-5 w-5" id="isRecurring" />
                            <label asp-for="IsRecurring" class="text-sm font-bold text-gray-600">Ricorrente</label>
                        </div>
                        <div id="recurrence-options" style="display: none;">
                            <select asp-for="Recurrence" class="px-3 py-1.5 bg-gray-100 dark:bg-gray-800 border-none rounded-lg text-xs font-bold focus:ring-primary" asp-items="Html.GetEnumSelectList<Models.TaskRecurrence>()"></select>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 w-full sm:w-auto">
                        <a href="/TodoTasks" class="flex-1 sm:flex-none text-center px-6 py-2.5 text-sm font-bold text-gray-400 hover:text-gray-600 transition-colors">Annulla</a>
                        <button type="submit" class="flex-1 sm:flex-none bg-primary hover:bg-primary/90 text-white px-10 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 transition-all">
                            Crea Attività
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('isRecurring').addEventListener('change', function() {
            document.getElementById('recurrence-options').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
